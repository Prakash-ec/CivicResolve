{
  "name": "civicresolve",
  "version": "1.0.0",
  "description": "CivicResolve — AI-Powered Civic Grievance Management Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "npm --prefix server run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix server run build && npm --prefix frontend run build",
    "seed:departments": "npm --prefix server run seed:departments",
    "seed:demo": "npm --prefix server run seed:demo",
    "clear:demo": "npm --prefix server run clear:demo",
    "make-admin": "npm --prefix server run make-admin --",
    "revoke-admin": "npm --prefix server run make-admin -- --revoke",
    "test": "npm --prefix server test && npm --prefix frontend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "civic-tech",
    "ai",
    "gemini",
    "grievance-redressal",
    "hackathon",
    "react",
    "express",
    "firebase"
  ],
  "author": "CivicResolve Team",
  "license": "MIT"
}
