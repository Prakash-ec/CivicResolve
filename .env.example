# ==============================================================================
# CIVICRESOLVE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- BACKEND SERVER CONFIGURATION (server/.env) ---
PORT=5000
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated allowlist)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=https://civicresolve-7j40.onrender.com

# Google Gemini API (Mandatory for multimodal classification & priority analysis)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=civicresolve-969d3

# Firebase Admin Credentials (Production on Render):
# Option A: Client Email and Private Key
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@civicresolve-969d3.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: Full JSON Service Account String
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Option C: Local service account file path (development only)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional Groq Fallback
GROQ_API_KEY=

# --- FRONTEND CONFIGURATION (frontend/.env) ---
# Backend API Base URL
# For local development: http://localhost:5000/api
# For Render production: https://civicresolve-m93a.onrender.com/api
VITE_API_BASE_URL=https://civicresolve-m93a.onrender.com/api

# Firebase Client SDK Configuration (Safe for client-side usage)
VITE_FIREBASE_API_KEY=your_firebase_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=civicresolve-969d3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civicresolve-969d3
VITE_FIREBASE_STORAGE_BUCKET=civicresolve-969d3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=408037973858
VITE_FIREBASE_APP_ID=1:408037973858:web:3ae53468fabf9e3375563b
