# ==============================================================================
# CIVICRESOLVE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- BACKEND SERVER CONFIGURATION (server/.env) ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Gemini API (Mandatory for multimodal classification & priority analysis)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=civicresolve-969d3
# Optional path to service account key file (or set GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional Groq API Key (Experimental comparison only - Gemini is primary)
GROQ_API_KEY=

# --- FRONTEND CONFIGURATION (frontend/.env) ---
# Firebase Client SDK Configuration (Safe for client-side usage)
VITE_FIREBASE_API_KEY=your_firebase_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=civicresolve-969d3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civicresolve-969d3
VITE_FIREBASE_STORAGE_BUCKET=civicresolve-969d3.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=408037973858
VITE_FIREBASE_APP_ID=1:408037973858:web:your_app_id

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
