# Backend Environment Variables Template
PORT=5000
NODE_ENV=development

# Allowed origins for CORS (comma-separated for multiple origins)
# For local development: http://localhost:5173
# For Render production: https://civicresolve-7j40.onrender.com
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=https://civicresolve-7j40.onrender.com

# Google Gemini API (Mandatory for multimodal classification & priority analysis)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=civicresolve-969d3

# Firebase Admin Credentials on Render (Choose either A or B):
# Option A (Recommended on Render): Provide Client Email and Private Key directly
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@civicresolve-969d3.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: Full JSON service account string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Option C: Local file path (development only)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional Groq Fallback
GROQ_API_KEY=
